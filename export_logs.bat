@echo off
chcp 65001 >nul
title Сбор диагностических логов Etix Checker

echo ============================================================
echo   Etix Checker 2026 - Сбор диагностических логов
echo ============================================================
echo.

if exist "venv\Scripts\python.exe" (
    set "PYTHON_EXE=venv\Scripts\python.exe"
) else (
    set "PYTHON_EXE=python"
)

echo [1/2] Формирование архива логов, отчетов и дампов...
%PYTHON_EXE% -m src.utils.diagnostics

echo.
echo ============================================================
echo [2/2] Готово! Если архив сформирован, папка открыта в Проводнике.
echo       Отправьте полученный ZIP-файл разработчику для анализа.
echo ============================================================
echo.
pause
